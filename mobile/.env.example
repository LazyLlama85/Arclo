# Arclo — local development environment.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is the
# checked-in list of what the app expects, with no real values in it.
#
# Every client key is EXPO_PUBLIC_*, which means it is inlined into the bundle at
# build time and is readable by anyone who downloads the app. That is fine for
# the keys below, which are all designed to be client-visible. It is NOT fine for
# anything billable or privileged: those live as Supabase edge-function secrets
# instead (see supabase/functions/exercise-media, which proxies a metered API so
# its key never ships in the binary).
#
# EAS Build does NOT read this file. Build-time values live in
# eas.json -> build.<profile>.env.

# ── Required ─────────────────────────────────────────────────────────────────
# Backend. The publishable key is the anon key; row-level security is what
# actually protects the data, not the secrecy of this value.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: subscriptions ──────────────────────────────────────────────────
# Without these the paywall reports plans unavailable and nothing can be bought.
# Pro also stays inert until the remote `pro_enabled` flag is on, so a missing
# key degrades to a free app rather than a broken one.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Cross-platform Test Store key, used as a fallback before the real appl_/goog_
# keys exist.
EXPO_PUBLIC_REVENUECAT_KEY=
# Must match the entitlement identifier in the RevenueCat dashboard.
EXPO_PUBLIC_PRO_ENTITLEMENT=pro

# ── Optional: telemetry ──────────────────────────────────────────────────────
# Both wrappers no-op safely when unset, which is exactly why a missing key here
# once went unnoticed for days: the app looks fine and is simply blind.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Disabled in __DEV__ by design, so test crash capture in a release build.
EXPO_PUBLIC_SENTRY_DSN=

# ── Optional: development ────────────────────────────────────────────────────
# Serve the AI coach from a local stub instead of the deployed edge function.
EXPO_PUBLIC_COACH_STUB=
